# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Environment
.env

# Fixture PDFs and generated output contain PII / customer data.
# They must never be committed to a (potentially public) repository.
# NOTE (Phase 5.0): this MUST stay anchored to the repo root. An earlier,
# unanchored "output/" here matched ANY directory named "output" anywhere in
# the tree -- including src/estimate_extractor/output/, the real source
# package cli.py and ui/pipeline_service.py both import from. That package
# was silently untracked as a result and, per `git log`, never existed in
# any commit -- the root cause of both entry points being unimportable.
fixtures/*.pdf
fixtures/originals/*.pdf
fixtures/supplements/*.pdf
/output/
_inspect/

# Phase 3.6 reference selector-screenshot library: the source ZIP is large
# (140MB) and Xactimate-proprietary-adjacent; extracted screenshots and
# generated data/reports are regeneratable from it via `selectors import`.
fixtures/reference/*.zip
fixtures/reference/extracted/*
!fixtures/reference/extracted/.gitkeep
fixtures/reference/data/*
!fixtures/reference/data/.gitkeep
fixtures/reference/reports/*
!fixtures/reference/reports/.gitkeep

# Phase 3 local review projects contain uploaded PDFs + extracted claim
# data (PII) and must never be committed.
projects/*
!projects/.gitkeep
config/backups/*
!config/backups/.gitkeep

# Local overrides
config.yaml
config.local.yaml

# Locally-learned/generated SQLite state (e.g. internal_lookup_registry.db --
# self-bootstraps via registry.create_database() and accumulates reviewer
# approvals over time; not a shared/static asset).
config/*.db

# Live Xactimate automation evidence (screenshots, per-run diagnostics) --
# always machine/session-local, never shared.
automation_evidence/

# pytest temp-directory fixtures left behind by ad hoc/manual test runs
# (tests that pass tmp_path explicitly outside the normal pytest tmp dir).
.pytest-tmp-*/

# Local Streamlit server logs from manual `streamlit run` invocations.
streamlit-server.*.log

# Historical artifact of a since-fixed unquoted --projects-dir bug: a
# mis-named sibling of projects/ that can contain real claim data. Ignored
# defensively in case it reappears; see projects/* above for the real path.
Userschrisclaim-extractorprojects/
